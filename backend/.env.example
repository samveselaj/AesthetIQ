# ---- Core ----
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string
LOG_LEVEL=INFO

# ---- Database ----
DATABASE_URL=postgresql+psycopg://medspa:medspa@localhost:5432/medspa

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- Auth ----
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
ACCESS_TOKEN_COOKIE_NAME=medspa_session

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to "true" to actually call OpenAI. When "false" the service returns
# deterministic stub responses — useful for local dev / CI / demo.
OPENAI_LIVE=false

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15557654321
# When true, inbound Twilio webhooks require a valid X-Twilio-Signature.
TWILIO_VALIDATE_SIGNATURE=true
# When false, outbound SMS is logged but not sent — useful for demos.
TWILIO_LIVE=false

# ---- Email (Resend or SendGrid) ----
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@medspa-assistant.local
EMAIL_LIVE=false

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Frontend URL (for links in emails) ----
APP_URL=http://localhost:3000

# ---- LemonSqueezy (Merchant of Record) ----
LEMONSQUEEZY_SIGNING_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID_STARTER=
LEMONSQUEEZY_VARIANT_ID_PRO=

# ---- Demo number (public-facing test line) ----
DEMO_TWILIO_NUMBER=
DEMO_MAX_MESSAGES_PER_24H=10
