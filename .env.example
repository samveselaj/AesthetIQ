# docker-compose.yml only. The backend itself reads a single DATABASE_URL
# (see backend/.env.example).
#
# These vars exist because the official postgres:15-alpine image requires
# POSTGRES_USER/PASSWORD/DB to bootstrap the container — it does not accept
# a connection URL. docker-compose then composes them into a DATABASE_URL
# that's passed to the api/worker services.
#
# All have defaults in docker-compose.yml (:-medspa, :-5432, etc.), so you
# only need to copy this file to .env if you want to override them locally.

POSTGRES_USER=medspa
POSTGRES_PASSWORD=medspa
POSTGRES_DB=medspa
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8000
WEB_PORT=3000
