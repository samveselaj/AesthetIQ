# Backend origin only — host with optional protocol, NO path, NO :path*
# The Next.js rewrite in next.config.mjs appends /api/v1/... automatically.
#
# Examples:
#   INTERNAL_API_URL=http://localhost:8000
#   INTERNAL_API_URL=https://aesthetiq-production-2ab6.up.railway.app
#
# Used by:
#   - next.config.mjs rewrites (server-side, build-time + runtime)
#   - server components (lib/api.ts when typeof window === "undefined")
INTERNAL_API_URL=http://localhost:8000

# Optional: only set if you need browser code to bypass the rewrite.
# Normally leave unset — browser calls go through /api/backend/* (same-origin).
# NEXT_PUBLIC_API_URL=
